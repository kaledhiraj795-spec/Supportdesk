NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/supportdesk
# This placeholder is rejected; replace it with a random secret of 32+ characters.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=3600
CORS_ORIGINS=http://localhost:5173
# Optional. Key prefixes do not reliably select the API backend.
# Developer API keys use generativelanguage.googleapis.com.
GEMINI_API_KEY=
# Set to "vertex" only for a Vertex AI Express key; this uses aiplatform.googleapis.com.
GEMINI_API_MODE=developer
GEMINI_MODEL=gemini-3.8-flash
# Optional USD pricing rates per million tokens; leave blank when unknown.
GEMINI_INPUT_COST_PER_1M=
GEMINI_OUTPUT_COST_PER_1M=
# Required only when intentionally creating Day 8 sample users with db:seed.
SUPPORTDESK_SEED_CUSTOMER_PASSWORD=replace-with-a-local-customer-password
SUPPORTDESK_SEED_AGENT_PASSWORD=replace-with-a-local-agent-password
